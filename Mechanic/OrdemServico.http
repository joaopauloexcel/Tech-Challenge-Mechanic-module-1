###

# =========================

# Criar OS

# =========================

POST {{Mechanic_HostAddress}}/api/ordens-servico
Authorization: Bearer {{token}}
Content-Type: application/json

{
"titulo": "Troca de óleo",
"descricao": "Cliente relatou barulho no motor",
"clienteId": 1,
"veiculoId": 1
}

###

# =========================

# Listar OS (filtros opcionais)

# =========================

GET {{Mechanic_HostAddress}}/api/ordens-servico
Authorization: Bearer {{token}}

###

# =========================

# Obter OS por ID

# =========================

GET {{Mechanic_HostAddress}}/api/ordens-servico/1
Authorization: Bearer {{token}}

###

# =========================

# Obter OS por HASH (público) + 3 últimos dígitos do Cpf/Cnpj

# =========================

GET {{Mechanic_HostAddress}}/api/ordem-servico/externo/da3e3383029e48d49ffb73f1a23b991f/080
Authorization: Bearer {{token}}

###

# =========================

# Iniciar diagnóstico

# =========================

POST {{Mechanic_HostAddress}}/api/ordens-servico/1/iniciar-diagnostico
Authorization: Bearer {{token}}

###

# =========================

# Enviar orçamento

# =========================

POST {{Mechanic_HostAddress}}/api/ordens-servico/1/enviar-orcamento
Authorization: Bearer {{token}}
Content-Type: application/json

{
"descricao": "Orçamento inicial",
"produtosOS": [
{
"produtoId": 1,
"qtdProduto": 2,
"precoUnitarioProduto": 50
}
],
"servicosOS": [
{
"servicoId": 1,
"precoServico": 100
}
]
}

###

# =========================

# Aprovar orçamento

# =========================

PATCH {{Mechanic_HostAddress}}/api/ordem-servico/externo/da3e3383029e48d49ffb73f1a23b991f/080/orcamento/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
"aprovar": true
}

###

# =========================

# Reprovar orçamento

# =========================

PATCH {{Mechanic_HostAddress}}/api/ordem-servico/externo/da3e3383029e48d49ffb73f1a23b991f/080/orcamento/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
"aprovar": false
}

###

# =========================

# Executar serviço - INICIAR

# =========================

POST {{Mechanic_HostAddress}}/api/ordens-servico/1/orcamentos/1/servicos/1/executar
Authorization: Bearer {{token}}
Content-Type: application/json

{
"acao": 1
}

###

# =========================

# Executar serviço - PAUSAR

# =========================

POST {{Mechanic_HostAddress}}/api/ordens-servico/1/orcamentos/1/servicos/1/executar
Authorization: Bearer {{token}}
Content-Type: application/json

{
"acao": 2
}

###

# =========================

# Executar serviço - FINALIZAR

# =========================

POST {{Mechanic_HostAddress}}/api/ordens-servico/1/orcamentos/1/servicos/1/executar
Authorization: Bearer {{token}}
Content-Type: application/json

{
"acao": 3
}

###

# =========================

# Cancelar OS

# =========================

POST {{Mechanic_HostAddress}}/api/ordens-servico/1/status/cancelar
Authorization: Bearer {{token}}

###

# =========================

# Finalizar OS

# =========================

POST {{Mechanic_HostAddress}}/api/ordens-servico/1/status/finalizar
Authorization: Bearer {{token}}

###

# =========================

# Entregar OS

# =========================

POST {{Mechanic_HostAddress}}/api/ordens-servico/1/status/entregar
Authorization: Bearer {{token}}

###

# =========================

# Relatório tempo médio

# =========================

GET {{Mechanic_HostAddress}}/api/ordens-servico/relatorios/servicos/tempo-medio
Authorization: Bearer {{token}}
